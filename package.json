{
  "name": "grantlynx-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "GrantLynx — Confidential Grant Milestone Verification & Funding Release Platform on Midnight Network",
  "workspaces": [
    "contract",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "compile:contract": "npm run compile --workspace=contract",
    "test:contract": "npm run test --workspace=contract",
    "test": "npm run test:contract && npm run test --workspace=frontend --if-present",
    "check-balance": "npm run check-balance --workspace=contract",
    "deploy:contract": "npm run deploy --workspace=contract"
  },
  "keywords": [
    "midnight-network",
    "compact",
    "zero-knowledge",
    "grants",
    "milestone-verification",
    "privacy-preserving",
    "zk-snarks"
  ],
  "author": "GrantLynx Core Engineering",
  "license": "Apache-2.0",
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.1.1"
  }
}

