# ==============================================================================
# GRANTLYNX ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Target Network (preview | preprod)
VITE_NETWORK_ID=preview

# Midnight Preview Network Endpoints
VITE_PREVIEW_RPC_URL=https://rpc.preview.midnight.network
VITE_PREVIEW_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_PREVIEW_INDEXER_WS=wss://indexer.preview.midnight.network/api/v4/ws
VITE_PREVIEW_CONTRACT_ADDRESS=

# Midnight Preprod Network Endpoints
VITE_PREPROD_RPC_URL=https://rpc.preprod.midnight.network
VITE_PREPROD_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_PREPROD_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/ws
VITE_PREPROD_CONTRACT_ADDRESS=

# Block Explorers (Plural endpoints: /contracts/[address] & /transactions/[txHash])
VITE_PREVIEW_EXPLORER=https://preview.midnightexplorer.com
VITE_PREPROD_EXPLORER=https://testnet.midnightexplorer.com

# Local Proof Server (Midnight ProofStation)
VITE_PROOF_SERVER_URL=http://localhost:6300

# Application Metadata
VITE_APP_NAME=GrantLynx
VITE_APP_DESCRIPTION="Confidential Grant Milestone Verification & Tranche Release Engine"
VITE_APP_VERSION=1.0.0

